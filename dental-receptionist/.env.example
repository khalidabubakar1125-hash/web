# Copy to .env and fill in. Never commit the real .env file.

# --- Vapi ---
VAPI_API_KEY=
# Shared secret Vapi sends back in the X-Vapi-Secret header on every webhook call.
# Generate any long random string, e.g. `openssl rand -hex 32`.
VAPI_SERVER_SECRET=
# Optional overrides — see src/assistant/buildAssistant.ts for the swap point.
VAPI_LLM_PROVIDER=anthropic
VAPI_LLM_MODEL=claude-3-5-sonnet-20241022
VAPI_BASE_URL=https://api.vapi.ai

# Public HTTPS base URL of this server once deployed (Railway URL, custom domain, or
# an ngrok tunnel during local dev). Used both by the assistant builder (to register
# the webhook URL with Vapi) and isn't read by the server itself.
PUBLIC_WEBHOOK_BASE_URL=

# --- Anthropic (Claude) ---
# Used as the assistant's LLM via Vapi (VAPI_LLM_PROVIDER=anthropic) and, optionally,
# for best-effort call-intent classification when a call never triggers a tool call.
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-3-5-haiku-20241022

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# UK number in E.164 format, e.g. +44161XXXXXXX
TWILIO_PHONE_NUMBER=

# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# SQLite file path override (defaults to ./data/dental-receptionist.db)
SQLITE_PATH=

# Practice to use when a webhook event can't be matched to a config any other way
# (assistant id / phone number id / metadata). Set this for a single-practice demo
# deployment; multi-practice deployments resolve automatically per-call.
DEFAULT_PRACTICE_SLUG=brightside-demo

# --- Admin page (basic auth) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
